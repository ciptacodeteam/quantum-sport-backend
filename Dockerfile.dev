# ============================================
# Development Dockerfile
# ============================================
FROM oven/bun:1.3-alpine

WORKDIR /app

# Build-time value only; Compose overrides it with the development database URL.
ENV DATABASE_URL=postgresql://build:build@localhost:5432/build?schema=public

# Install system dependencies
RUN apk add --no-cache postgresql-client git

# Copy package files
COPY package.json ./

# Copy prisma schema BEFORE bun install (needed for postinstall script)
COPY prisma ./prisma
COPY prisma.config.ts ./

# Install dependencies (postinstall will run prisma generate)
RUN bun install 

# Copy config files
COPY tsconfig.json ./

# Copy source code and entry point
COPY src ./src
COPY scripts ./scripts
COPY serve.ts ./

# Expose ports (app + prisma studio)
EXPOSE 3000 5555

# Default command for development with hot reload
CMD ["bun", "run", "--hot", "serve.ts"]
