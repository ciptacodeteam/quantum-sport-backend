# ============================================
# Staging Environment Variables Template
# ============================================
# Second stack on the same droplet as production.
# Copy this file to .env in the staging checkout only.
# DO NOT commit .env, and do not point these values at the production database.
#
# Prefer copying the working production .env, then change every value marked
# STAGING below. Keep Fazpass, SMTP, and Midtrans keys filled if staging
# should send real OTP and payments.

# --------------------------------------------
# Stack isolation (STAGING)
# --------------------------------------------
NODE_ENV=staging
DEPLOY_ENV=staging
COMPOSE_PROJECT_NAME=quantum-sport-staging
# Safety net if nginx/certbot are started. Do not use 80/443.
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
CERTBOT_CONTAINER_NAME=quantum-sport-certbot-staging

# --------------------------------------------
# Application (STAGING)
# --------------------------------------------
PORT=8001
APP_NAME="Quantum Sport Staging"
APP_URL=http://YOUR_SERVER_IP:8001
BASE_URL=http://YOUR_SERVER_IP:8001
# App reads FRONT_END_URL (Midtrans finish redirect, CORS-related links).
FRONT_END_URL=https://staging.quantumsocialclub.id
WEBHOOK_BASE_URL=http://YOUR_SERVER_IP:8001/webhooks

# --------------------------------------------
# Database — same Postgres container as production, different database
# --------------------------------------------
# Host is the production container name, reached over its Docker network.
# Do not use localhost, 127.0.0.1:5433, or the service name "db".
DB_NAME=quantum_sport_staging
DB_USER=quantum_staging
DB_PASSWORD=your_staging_db_password_here
# Tip: wrap passwords with special characters ($, !, spaces) in quotes:
# DB_PASSWORD='a1ndi$'
DB_HOST=quantum-sport-db-prod
DB_PORT=5432
# DATABASE_URL=postgresql://quantum_staging:your_staging_db_password_here@quantum-sport-db-prod:5432/quantum_sport_staging?schema=public

# --------------------------------------------
# Redis (internal to this compose project)
# --------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --------------------------------------------
# JWT & Security — use secrets that differ from production (STAGING)
# --------------------------------------------
JWT_SECRET=staging_jwt_secret_min_32_chars_here
JWT_REFRESH_SECRET=staging_refresh_secret_min_32_chars
JWT_ISSUER=quantum-sport-backend
JWT_AUDIENCE=quantum-sport-frontend
JWT_EXPIRES=60
JWT_REFRESH_EXPIRES=30

# --------------------------------------------
# Email (SMTP) — same provider as production if mail should really send
# --------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@your-domain.com

# --------------------------------------------
# Fazpass OTP — required for real SMS OTP when NODE_ENV=staging
# --------------------------------------------
FAZPASS_MERCHANT_KEY=your_fazpass_merchant_key
FAZPASS_GATEWAY_KEY=your_fazpass_gateway_key
FAZPASS_API_URL=https://api.fazpass.com/v1

# --------------------------------------------
# Midtrans
# --------------------------------------------
MIDTRANS_MERCHANT_ID=your_midtrans_merchant_id
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key

# --------------------------------------------
# Xendit (legacy invoices)
# --------------------------------------------
XENDIT_API_KEY=your_xendit_secret_key
XENDIT_CALLBACK_TOKEN=your_xendit_webhook_token

# --------------------------------------------
# File Storage (Vercel Blob)
# --------------------------------------------
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token
BLOB_BACKUP_PREFIX=quantum-sport/db-staging
BACKUP_RETENTION_DAYS=30

# --------------------------------------------
# Optional
# --------------------------------------------
# LOG_LEVEL=info
# PWD_PEPPER=use_a_value_different_from_production
